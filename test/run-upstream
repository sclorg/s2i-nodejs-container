#!/usr/bin/env python3
"""
Python wrapper for Node.js upstream client package tests.

This script provides a Python entry point while delegating to the bash
test implementation for upstream npm package tests (express, pino, etc.).

IMAGE_NAME specifies the name of the candidate image used for testing.
The image must be available before this script is executed.

For each client package test, XXX_REVISION specifies which branch or tag
should be tested; by default it uses the latest released version as reported
by `npm show XXX version`.
"""

import os
import sys
import subprocess
from pathlib import Path


def main():
    """Execute the bash test script for upstream packages."""

    # Validate required environment variables
    if not os.environ.get('IMAGE_NAME'):
        print("ERROR: IMAGE_NAME environment variable must be set", file=sys.stderr)
        return 1

    if not os.environ.get('VERSION'):
        print("ERROR: VERSION environment variable must be set", file=sys.stderr)
        return 1

    # Get the directory containing this script
    script_dir = Path(__file__).parent.resolve()
    bash_script = script_dir / "run-upstream.sh"

    # Verify bash implementation exists
    if not bash_script.is_file():
        print(f"ERROR: Bash test implementation not found: {bash_script}", file=sys.stderr)
        return 1

    # Execute the bash script
    try:
        result = subprocess.run(
            ["/bin/bash", str(bash_script)],
            cwd=script_dir,
            env=os.environ.copy()
        )
        return result.returncode

    except KeyboardInterrupt:
        print("\nTests interrupted by user", file=sys.stderr)
        return 130

    except Exception as e:
        print(f"ERROR: Failed to execute test script: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
